{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1"
  },
  "language": "japanese",
  "showTurnDuration": true,
  "spinnerTipsEnabled": false,
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(git add:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git commit:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh repo view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(rg:*)",
      "Bash(npm test:*)",
      "Bash(npm run test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm build:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh api:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git reset --hard:*)",

      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.*.local)",
      "Read(**/.env.*.local)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Read(**/secrets/**)",
      "Read(secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.*)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",

      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(.env.local)",
      "Edit(**/.env.local)",
      "Edit(.env.*.local)",
      "Edit(**/.env.*.local)",
      "Edit(.env.production)",
      "Edit(**/.env.production)",
      "Edit(.env.staging)",
      "Edit(**/.env.staging)",
      "Edit(**/secrets/**)",
      "Edit(secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",

      "Write(.env)",
      "Write(**/.env)",
      "Write(.env.local)",
      "Write(**/.env.local)",
      "Write(.env.*.local)",
      "Write(**/.env.*.local)",
      "Write(**/secrets/**)",
      "Write(secrets/**)",

      "Bash(cat .env:*)",
      "Bash(cat .env)",
      "Bash(cat **/.env:*)",

      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Write(~/.aws/**)"
    ]
  }
}
